# Copy to .env and change what you need. Nothing here is a real secret.
# Every value below is the default, so the app also runs with no .env at all.

# Which folder holds the catalog and price CSV files.
# data/sample holds made-up sample data. Use data/live for real data.
DATA_DIR=data/sample

# Where user-sent prices, the review queue and reports are kept.
DATA_RUNTIME_DIR=data/runtime

# Areas and postcodes live in this file.
AREAS_FILE=config/areas.json

# Which areas are switched on. Empty means every area marked enabled in the file.
# Example: LAUNCH_AREAS=sample-town
LAUNCH_AREAS=

CURRENCY=EUR
FRESHNESS_DAYS=14
DEFAULT_RADIUS_KM=3
MIN_RADIUS_KM=1
MAX_RADIUS_KM=10

# Receipts and photos (Phase 2). "fake" reads plain text receipts only.
# A real vision provider is not built yet.
RECEIPT_READER=fake
RECEIPT_MAX_AGE_DAYS=7
OUTLIER_PCT=0.4
PRICE_JUMP_PCT=0.5

# Limits per client, kept in memory.
RATE_LIMIT_PER_MIN=60
SUBMIT_RATE_LIMIT_PER_HOUR=10

# Serve the app under a path, such as /cheapcart/, behind a proxy. Empty means the root.
# It's read when the app is built and when it starts, so rebuild after changing it.
BASE_PATH=

# Believe the client address in X-Forwarded-For. Only set this when the app sits behind your own
# proxy on the same machine and listens on 127.0.0.1, for example TRUST_PROXY=127.0.0.1.
# Left empty, the header is ignored and the rate limits count every request together.
TRUST_PROXY=

# The port, kept here by setup_service.sh.
PORT=3000

# Log file with a size limit. Copy it from the VM when you want help with a fix.
LOG_DIR=logs
LOG_MAX_BYTES=1000000
LOG_KEEP=3

# Shown on the legal pages. Fill these in before any real launch.
OPERATOR_NAME=
CONTACT_EMAIL=
